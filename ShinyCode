get_assay_data_safe <- function(obj, slot_or_layer = "data") {
  assay_use <- Seurat::DefaultAssay(obj)
  out <- tryCatch(
    Seurat::GetAssayData(obj, assay = assay_use, layer = slot_or_layer),
    error = function(e) {
      Seurat::GetAssayData(obj, assay = assay_use, slot = slot_or_layer)
    }
  )
  out
}

parse_signature_genes <- function(x) {
  x <- as.character(x %||% "")
  genes <- unlist(strsplit(x, "[,;\\s]+", perl = TRUE))
  genes <- trimws(genes)
  genes <- genes[nzchar(genes)]
  unique(genes)
}

match_gene_symbols <- function(query_genes, available_genes) {
  query_genes <- unique(as.character(query_genes))
  query_genes <- query_genes[!is.na(query_genes) & nzchar(query_genes)]
  available_genes <- as.character(available_genes)
  map <- stats::setNames(available_genes, toupper(available_genes))
  out <- unname(map[toupper(query_genes)])
  unique(out[!is.na(out) & nzchar(out)])
}

