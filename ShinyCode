order_groups_priority <- function(groups) {
  groups <- unique(as.character(groups))
  groups <- groups[!is.na(groups)]
  
  priority <- c(
    "Cancer Epithelial",
    "Normal Epithelial",
    "Cancer Basal SC",
    "Cancer Cycling",
    "Cancer Her2 SC",
    "Cancer LumA SC",
    "Cancer LumB SC",
    "Mature Luminal",
    "Luminal Progenitors",
    "Myoepithelial"
  )
  
  c(
    intersect(priority, groups),
    sort(setdiff(groups, priority))
  )
}

make_palette <- function(groups) {
  groups <- order_groups_priority(groups)
  
  if (length(groups) == 0) {
    return(character(0))
  }
  
  pal <- character(length(groups))
  names(pal) <- groups
  
  known <- intersect(groups, names(priority_colors))
  pal[known] <- priority_colors[known]
  
  remaining <- setdiff(groups, known)
  if (length(remaining) > 0) {
    extra_pal <- paper_like_palette
    extra_pal <- extra_pal[!extra_pal %in% pal[known]]
    
    if (length(remaining) <= length(extra_pal)) {
      pal[remaining] <- extra_pal[seq_along(remaining)]
    } else {
      pal[remaining] <- colorRampPalette(extra_pal)(length(remaining))
    }
  }
  
  pal
}

safe_palette <- function(n) {
  if (n <= 0) {
    character(0)
  } else if (n <= length(paper_like_palette)) {
    paper_like_palette[seq_len(n)]
  } else {
    colorRampPalette(paper_like_palette)(n)
  }
}

