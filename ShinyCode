  output$de_go_dotplot <- renderPlot(de_go_dotplot_plot())
  
  output$de_dl_go_csv <- downloadHandler(
    filename = function() paste0(input$de_filebase, "_GO_", input$de_go_ont, "_", input$de_subtype, "_", input$de_gene, ".csv"),
    content = function(file) readr::write_csv(de_go_table_data(), file)
  )
  
  output$de_dl_go_dotplot <- downloadHandler(
    filename = function() paste0(input$de_filebase, "_GO_Dotplot_", input$de_go_ont, "_", input$de_subtype, "_", input$de_gene, ".pdf"),
