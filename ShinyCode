get_go_annotation_for_genes <- function(genes) {
  if (!requireNamespace("AnnotationDbi", quietly = TRUE) ||
      !requireNamespace("org.Hs.eg.db", quietly = TRUE) ||
      !requireNamespace("GO.db", quietly = TRUE)) {
    stop(
      "GO discovery requires Bioconductor packages AnnotationDbi, org.Hs.eg.db and GO.db. ",
      "Install them with: BiocManager::install(c('AnnotationDbi', 'org.Hs.eg.db', 'GO.db'))"
    )
  }
  
  orgdb <- getFromNamespace("org.Hs.eg.db", "org.Hs.eg.db")
  genes <- unique(as.character(genes))
  genes <- genes[!is.na(genes) & nzchar(genes)]
  
  org_cols <- AnnotationDbi::columns(orgdb)
  if (all(c("GOALL", "ONTOLOGYALL") %in% org_cols)) {
    ann <- suppressWarnings(
      AnnotationDbi::select(
        orgdb,
        keys = genes,
        keytype = "SYMBOL",
        columns = c("SYMBOL", "GOALL", "ONTOLOGYALL")
      )
    ) %>%
      dplyr::rename(GO = GOALL, ONTOLOGY = ONTOLOGYALL)
  } else {
    ann <- suppressWarnings(
      AnnotationDbi::select(
        orgdb,
        keys = genes,
        keytype = "SYMBOL",
        columns = c("SYMBOL", "GO", "ONTOLOGY")
      )
    )
  }
  
  ann <- ann %>%
    dplyr::filter(!is.na(SYMBOL), !is.na(GO), !is.na(ONTOLOGY)) %>%
    dplyr::distinct(SYMBOL, GO, ONTOLOGY)
  
  if (nrow(ann) == 0) {
    return(tibble::tibble(SYMBOL = character(), GO = character(), ONTOLOGY = character(), TERM = character()))
  }
  
  go_info <- suppressWarnings(
    AnnotationDbi::select(
      GO.db::GO.db,
      keys = unique(ann$GO),
      keytype = "GOID",
      columns = c("TERM", "ONTOLOGY")
    )
  )
  
  go_info <- go_info %>%
    dplyr::rename(GO = GOID, GO_ONTOLOGY = ONTOLOGY) %>%
    dplyr::distinct(GO, TERM, GO_ONTOLOGY)
  
  ann %>%
    dplyr::left_join(go_info, by = "GO") %>%
    dplyr::mutate(
      TERM = ifelse(is.na(TERM), GO, TERM),
      ONTOLOGY = ifelse(is.na(ONTOLOGY), GO_ONTOLOGY, ONTOLOGY)
    ) %>%
    dplyr::select(SYMBOL, GO, ONTOLOGY, TERM) %>%
    dplyr::distinct()
}

run_signature_gene_association <- function(
    obj,
    signature_genes,
    min_pct = 0.05,
    exclude_signature = TRUE,
    max_cells = 10000,
    random_seed = 1
) {
  signature_genes <- match_gene_symbols(signature_genes, rownames(obj))
  
  if (length(signature_genes) < 2) {
    stop("At least two signature genes must be present in the selected object.")
  }
  
  mat <- get_assay_data_safe(obj, "data")
  cells_use <- colnames(obj)
  cells_use <- intersect(cells_use, colnames(mat))
  
  if (length(cells_use) < 3) {
    stop("Too few cells in the selected population.")
  }
  
  max_cells <- as.integer(max_cells %||% 10000)
  if (is.finite(max_cells) && max_cells > 0 && length(cells_use) > max_cells) {
    set.seed(as.integer(random_seed %||% 1))
    cells_use <- sample(cells_use, max_cells)
  }
  
  mat <- mat[, cells_use, drop = FALSE]
  signature_genes <- intersect(signature_genes, rownames(mat))
  
  if (length(signature_genes) < 2) {
    stop("Too few signature genes are present after subsetting.")
  }
  
  score <- Matrix::colMeans(mat[signature_genes, , drop = FALSE])
  score <- as.numeric(score)
  
  if (stats::sd(score, na.rm = TRUE) == 0 || !is.finite(stats::sd(score, na.rm = TRUE))) {
    stop("The signature score has zero variance in the selected cells.")
  }
  
  min_pct <- as.numeric(min_pct %||% 0.05)
  min_pct <- min(max(min_pct, 0), 1)
  pct_all <- Matrix::rowMeans(mat > 0)
  genes_test <- names(pct_all)[pct_all >= min_pct]
  
  if (isTRUE(exclude_signature)) {
    genes_test <- setdiff(genes_test, signature_genes)
  }
  
  genes_test <- intersect(genes_test, rownames(mat))
  
  if (length(genes_test) < 5) {
    stop("Too few genes pass the expression filter.")
  }
  
  mat_test <- mat[genes_test, , drop = FALSE]
  n <- ncol(mat_test)
  y_centered <- score - mean(score, na.rm = TRUE)
  y_ss <- sum(y_centered^2, na.rm = TRUE)
  
  x_mean <- Matrix::rowMeans(mat_test)
  x_ss <- Matrix::rowSums(mat_test^2) - n * (x_mean^2)
  numerator <- as.numeric(mat_test %*% y_centered)
  denom <- sqrt(as.numeric(x_ss) * y_ss)
  correlation <- numerator / denom
  correlation[!is.finite(correlation)] <- NA_real_
  
  pval <- rep(NA_real_, length(correlation))
  ok <- !is.na(correlation) & abs(correlation) < 1 & n > 2
  tstat <- correlation[ok] * sqrt((n - 2) / pmax(1 - correlation[ok]^2, .Machine$double.eps))
  pval[ok] <- 2 * stats::pt(-abs(tstat), df = n - 2)
  pval[!ok & !is.na(correlation) & abs(correlation) >= 1] <- 0
  padj <- stats::p.adjust(pval, method = "BH")
  
  out <- tibble::tibble(
    gene = genes_test,
    correlation = as.numeric(correlation),
    p.value = as.numeric(pval),
    p.adjust = as.numeric(padj),
    avg_expr = as.numeric(x_mean),
    pct_expr = as.numeric(pct_all[genes_test]),
    association_score = correlation * (-log10(padj + 1e-300)),
    direction = dplyr::case_when(
      correlation > 0 ~ "Positive association",
      correlation < 0 ~ "Negative association",
      TRUE ~ "No association"
    )
  ) %>%
    dplyr::arrange(p.adjust, dplyr::desc(abs(correlation)))
  
  attr(out, "signature_genes") <- signature_genes
  attr(out, "n_cells") <- n
  attr(out, "n_genes_tested") <- length(genes_test)
  attr(out, "score_mean") <- mean(score)
  attr(out, "score_sd") <- stats::sd(score)
  out
}

make_discovery_association_plot <- function(
    df,
    top_n = NULL,
    base_size = 11,
    gene_text_size = NULL,
    title = NULL
) {
  validate(need(nrow(df) > 0, "No discovery result to plot."))
  
  if (!is.null(top_n) && is.finite(as.numeric(top_n))) {
    top_n <- max(1, as.integer(top_n))
    pos <- df %>%
      dplyr::filter(!is.na(correlation), correlation > 0) %>%
      dplyr::arrange(dplyr::desc(correlation), p.adjust) %>%
      dplyr::slice_head(n = top_n)
    
    neg <- df %>%
      dplyr::filter(!is.na(correlation), correlation < 0) %>%
      dplyr::arrange(correlation, p.adjust) %>%
      dplyr::slice_head(n = top_n)
    
    plot_input <- dplyr::bind_rows(neg, pos)
  } else {
    plot_input <- df %>%
      dplyr::filter(!is.na(correlation), correlation != 0) %>%
      dplyr::arrange(correlation)
  }
  
  plot_df <- plot_input %>%
    dplyr::mutate(
      gene = factor(gene, levels = gene[order(correlation)]),
      neglog10_padj = -log10(p.adjust + 1e-300),
      direction = factor(direction, levels = c("Negative association", "Positive association"))
    )
  
  validate(need(nrow(plot_df) > 0, "No positive or negative associated gene to plot."))
  
  if (is.null(title) || !nzchar(as.character(title))) {
    title <- "Genes associated with signature score"
  }
  
  ggplot(plot_df, aes(x = correlation, y = gene)) +
    geom_vline(xintercept = 0, color = "grey55", linewidth = 0.35) +
    geom_segment(
      aes(x = 0, xend = correlation, y = gene, yend = gene, color = direction),
      linewidth = 1.3,
      alpha = 0.9,
      lineend = "round"
    ) +
    geom_point(
      aes(size = neglog10_padj, color = direction),
      alpha = 0.95
    ) +
    scale_color_manual(
      values = c(
        "Negative association" = "#3C5488FF",
        "Positive association" = "#8BC7A7"
      ),
      drop = FALSE
    ) +
    scale_size_continuous(name = expression(-log[10](adjusted~p)), range = c(2.8, 7.8)) +
    labs(
      title = title,
      x = "Pearson correlation with signature score",
      y = NULL,
      color = NULL
    ) +
    theme_paper(base_size) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold", size = base_size + 1),
      axis.text.y = element_text(size = gene_text_size %||% (base_size + 1), color = "#333333"),
      axis.text.x = element_text(size = base_size, color = "#333333"),
      axis.title.x = element_text(size = base_size + 1, face = "bold"),
      legend.position = "right",
      panel.grid.major.y = element_blank(),
      panel.grid.minor = element_blank(),
      panel.grid.major.x = element_line(color = "grey88", linewidth = 0.35),
      plot.margin = margin(10, 20, 10, 20)
    )
}

