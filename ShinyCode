# ============================================================
# Server
# ============================================================

server <- function(input, output, session) {
  
  observeEvent(input$go_viewer, {
    updateNavbarPage(session, "mainnav", selected = "Single-cell analyser")
  })
  
  observeEvent(input$go_chip, {
    updateNavbarPage(session, "mainnav", selected = "T47-D ChIP viewer")
  })
  
  observe({
    updateSelectizeInput(session, "global_gene", choices = genes_all, selected = genes_all[1], server = TRUE)
    updateSelectizeInput(session, "minor_gene", choices = genes_all, selected = genes_all[1], server = TRUE)
    updateSelectizeInput(session, "de_gene", choices = genes_all, selected = genes_all[1], server = TRUE)
    updateSelectizeInput(session, "de_violin_genes", choices = genes_all, selected = character(0), server = TRUE)
  })
  
  # ============================================================
  # Single-cell object helpers
  # ============================================================
  
  subtype_cells <- function(subtype) {
    subtype <- as.character(subtype)
    
    if (length(subtype) == 0 || is.na(subtype)) {
      return(character(0))
    }
    
    if (identical(subtype, "ALL")) {
      return(colnames(seurat_obj))
    }
    
    colnames(seurat_obj)[as.character(seurat_obj$subtype) == subtype]
  }
  
  major_choices_for_subtype <- function(subtype) {
    cells <- subtype_cells(subtype)
    
    if (length(cells) == 0) {
      return(character(0))
    }
    
    out <- sort(unique(as.character(seurat_obj$celltype_major[cells])))
    out[!is.na(out)]
  }
  
  # ============================================================
  # Discovery module
  # ============================================================
  
  disc_go_annotation_cache <- reactiveVal(NULL)
  
  get_disc_go_annotation <- function() {
    cached <- disc_go_annotation_cache()
    if (!is.null(cached)) {
      return(cached)
    }
    
    ann <- withProgress(message = "Loading GO annotations", value = 0, {
      incProgress(0.2)
      out <- get_go_annotation_for_genes(genes_all)
      incProgress(0.8)
      out
    })
    
    disc_go_annotation_cache(ann)
    ann
  }
  
  output$disc_major_ui <- renderUI({
    req(input$disc_subtype)
    choices <- major_choices_for_subtype(input$disc_subtype)
    validate(need(length(choices) > 0, "No major cell type available for the selected subtype."))
    selectInput("disc_major", "Major cell type", choices = choices, selected = choices[1])
  })
  
  disc_base_obj <- reactive({
    req(input$disc_subtype)
    cells <- subtype_cells(input$disc_subtype)
    validate(need(length(cells) > 0, "No cells available for the selected subtype."))
    subset(seurat_obj, cells = cells)
  })
  
  disc_major_obj <- reactive({
    req(input$disc_subtype, input$disc_major)
    obj <- disc_base_obj()
    cells <- colnames(obj)[as.character(obj$celltype_major) == as.character(input$disc_major)]
    validate(need(length(cells) > 0, "No cells available for the selected major cell type."))
    subset(obj, cells = cells)
  })
  
  output$disc_minor_level_ui <- renderUI({
    req(input$disc_scope, input$disc_major, input$disc_minor_groupby)
    
    if (!identical(input$disc_scope, "minor_annotation")) {
      return(NULL)
    }
    
    obj <- disc_major_obj()
    validate(need(input$disc_minor_groupby %in% colnames(obj@meta.data), "Minor annotation not found."))
    
    levels_use <- sort(unique(as.character(obj@meta.data[[input$disc_minor_groupby]])))
    levels_use <- levels_use[!is.na(levels_use)]
    selectInput("disc_minor_level", "Minor population", choices = levels_use, selected = levels_use[1])
  })
  
  disc_obj <- reactive({
    if (identical(input$disc_scope, "all")) {
      obj <- disc_base_obj()
    } else if (identical(input$disc_scope, "major")) {
      obj <- disc_major_obj()
    } else {
      req(input$disc_minor_groupby, input$disc_minor_level)
      obj <- disc_major_obj()
      cells <- colnames(obj)[
        as.character(obj@meta.data[[input$disc_minor_groupby]]) == as.character(input$disc_minor_level)
      ]
      validate(need(length(cells) > 0, "No cells available for the selected minor population."))
      obj <- subset(obj, cells = cells)
    }
    obj
  })
  
  observeEvent(input$disc_search_go, {
    ann <- get_disc_go_annotation()
    keyword <- trimws(as.character(input$disc_go_keyword %||% ""))
    ont <- as.character(input$disc_go_ont %||% "BP")
    min_genes <- as.integer(input$disc_go_min_genes %||% 5)
    
    term_df <- ann %>%
      dplyr::filter(ONTOLOGY == ont) %>%
      dplyr::group_by(GO, TERM, ONTOLOGY) %>%
      dplyr::summarise(n_genes = dplyr::n_distinct(SYMBOL), .groups = "drop") %>%
      dplyr::filter(n_genes >= min_genes)
    
    if (nzchar(keyword)) {
      term_df <- term_df %>%
        dplyr::filter(grepl(keyword, TERM, ignore.case = TRUE) | grepl(keyword, GO, ignore.case = TRUE))
    }
    
    term_df <- term_df %>%
      dplyr::arrange(dplyr::desc(n_genes), TERM) %>%
      dplyr::slice_head(n = 500)
    
    if (nrow(term_df) == 0) {
      showNotification("No matching GO term found. Try a broader keyword or a lower minimum gene number.", type = "warning")
      updateSelectInput(session, "disc_go_term", choices = character(0))
    } else {
      labels <- paste0(term_df$GO, " | ", term_df$TERM, " (", term_df$n_genes, " genes)")
      updateSelectInput(
        session,
        "disc_go_term",
        choices = stats::setNames(term_df$GO, labels),
        selected = term_df$GO[1]
      )
    }
  }, ignoreInit = TRUE)
  
  disc_signature_genes <- reactive({
    if (identical(input$disc_signature_mode, "go")) {
      req(input$disc_go_term)
      ann <- get_disc_go_annotation()
      raw_genes <- ann %>%
        dplyr::filter(GO == input$disc_go_term) %>%
        dplyr::pull(SYMBOL) %>%
        unique()
    } else {
      raw_genes <- parse_signature_genes(input$disc_custom_genes)
    }
    
    match_gene_symbols(raw_genes, rownames(seurat_obj))
  })
  
  output$disc_signature_table <- renderDT({
    genes <- disc_signature_genes()
    df <- tibble::tibble(signature_gene_present = genes)
    DT::datatable(
      df,
      rownames = FALSE,
      class = "compact stripe hover row-border",
      options = list(pageLength = 8, lengthMenu = c(8, 15, 30, 100), scrollY = "230px", scrollCollapse = TRUE)
    )
  })
  
  disc_result <- eventReactive(input$disc_run, {
    obj <- disc_obj()
    sig <- disc_signature_genes()
    
    validate(
      need(length(sig) >= 2, "At least two signature genes must be present in the dataset."),
      need(ncol(obj) >= input$disc_min_cells, paste0("Too few cells in selected population: ", ncol(obj)))
    )
    
    withProgress(message = "Running signature association", value = 0, {
      incProgress(0.25)
      out <- run_signature_gene_association(
        obj = obj,
        signature_genes = sig,
        min_pct = input$disc_min_pct,
        exclude_signature = input$disc_exclude_signature,
        max_cells = input$disc_max_cells,
        random_seed = 1
      )
      incProgress(0.75)
      
      attr(out, "subtype") <- input$disc_subtype
      attr(out, "scope") <- input$disc_scope
      attr(out, "major") <- input$disc_major %||% NA
      attr(out, "minor_groupby") <- input$disc_minor_groupby %||% NA
      attr(out, "minor_level") <- input$disc_minor_level %||% NA
      attr(out, "signature_mode") <- input$disc_signature_mode
      attr(out, "go_term") <- input$disc_go_term %||% NA
      attr(out, "go_keyword") <- input$disc_go_keyword %||% NA
      attr(out, "custom_signature") <- input$disc_custom_genes %||% NA
      out
    })
  }, ignoreInit = TRUE)
  
  output$disc_summary <- renderPrint({
    sig <- disc_signature_genes()
    obj <- disc_obj()
    
    cat("Signature mode:", input$disc_signature_mode, "\n")
    if (identical(input$disc_signature_mode, "go")) {
      ann <- get_disc_go_annotation()
      term <- ann %>% dplyr::filter(GO == input$disc_go_term) %>% dplyr::slice_head(n = 1)
      cat("GO term:", input$disc_go_term %||% NA, "\n")
      if (nrow(term) > 0) cat("Description:", term$TERM[1], "\n")
    }
    cat("Signature genes present:", length(sig), "\n")
    if (identical(as.character(input$disc_subtype), "ALL")) {
      cat("Subtype: ALL\n")
    } else {
      cat("Subtype:", input$disc_subtype, "\n")
    }
    if (identical(input$disc_scope, "all")) cat("Population: all cells\n")
    if (identical(input$disc_scope, "major")) cat("Population:", input$disc_major, "\n")
    if (identical(input$disc_scope, "minor_annotation")) {
      cat("Major:", input$disc_major, "\n")
      cat("Minor:", input$disc_minor_level, "\n")
      cat("Annotation:", input$disc_minor_groupby, "\n")
    }
    cat("Cells available:", ncol(obj), "\n")
    
    if (!is.null(disc_result())) {
      res <- disc_result()
      cat("Cells used:", attr(res, "n_cells"), "\n")
      cat("Genes tested:", attr(res, "n_genes_tested"), "\n")
      cat("Signature score mean:", signif(attr(res, "score_mean"), 4), "\n")
      cat("Signature score SD:", signif(attr(res, "score_sd"), 4), "\n")
    }
  })
  
  disc_table_data <- reactive({
    res <- disc_result()
    res %>%
      dplyr::mutate(
        direction = as.character(direction),
        abs_correlation = abs(correlation)
      ) %>%
      dplyr::arrange(
        dplyr::case_when(
          direction == "Negative association" ~ 1L,
          direction == "Positive association" ~ 2L,
          TRUE ~ 3L
        ),
        dplyr::desc(abs_correlation),
        p.adjust
      )
  })
  
  disc_default_rows <- reactive({
    df <- disc_table_data()
    top_n <- max(1, as.integer(input$disc_top_n %||% 10))
    neg_idx <- which(!is.na(df$correlation) & df$correlation < 0)
