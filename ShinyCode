sanitize_name <- function(x) {
  x <- as.character(x)
  x <- gsub("[^A-Za-z0-9]+", "_", x)
  x <- gsub("^_+|_+$", "", x)
  x <- gsub("_+", "_", x)
  x
}

make_local_reduction_name <- function(subtype, major) {
  paste0(
    "umap_local__",
    sanitize_name(subtype),
    "__",
    sanitize_name(major)
  )
}

