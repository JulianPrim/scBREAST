        logfc_cutoff = input$de_go_logfc_min,
        ont = input$de_go_ont,
        pvalue_cutoff = input$de_go_p_cut,
        qvalue_cutoff = input$de_go_q_cut,
        min_genes = input$de_go_min_genes,
        defining_gene = attr(res, "gene")
      )
      
      incProgress(0.9)
      go
    })
  })
  
  de_go_table_data <- reactive({
    go <- de_go_result()
    
    validate(
      need(nrow(go) > 0, "No enriched GO term found. Try relaxing the DE p-value, GO p-value/q-value, or |logFC| thresholds.")
    )
    
    go %>%
      dplyr::arrange(p.adjust, pvalue) %>%
      dplyr::mutate(
        Direction = as.character(Direction),
        Description = as.character(Description)
      )
  })
  
  de_go_default_rows <- reactive({
    df <- de_go_table_data()
    seq_len(min(nrow(df), max(1, as.integer(input$de_go_top_n %||% 10))))
  })
  
  de_go_selected_data <- reactive({
