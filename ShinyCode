get_logfc_col <- function(df) {
  if ("avg_log2FC" %in% colnames(df)) {
    "avg_log2FC"
  } else if ("avg_logFC" %in% colnames(df)) {
    "avg_logFC"
  } else {
    NULL
  }
}

parse_gene_ratio <- function(x) {
  vapply(as.character(x), function(z) {
    if (is.na(z) || !nzchar(z)) {
      return(NA_real_)
    }
    if (grepl("/", z, fixed = TRUE)) {
      nums <- suppressWarnings(as.numeric(strsplit(z, "/", fixed = TRUE)[[1]]))
      if (length(nums) >= 2 && is.finite(nums[1]) && is.finite(nums[2]) && nums[2] != 0) {
        return(nums[1] / nums[2])
      }
    }
    suppressWarnings(as.numeric(z))
  }, numeric(1))
}

wrap_label <- function(x, width = 42) {
  vapply(as.character(x), function(z) {
    paste(strwrap(z, width = width), collapse = "\n")
  }, character(1))
}

empty_go_table <- function() {
  tibble::tibble(
    Direction = character(),
    ID = character(),
    Description = character(),
    GeneRatio = character(),
    BgRatio = character(),
    pvalue = numeric(),
    p.adjust = numeric(),
    qvalue = numeric(),
    geneID = character(),
    Count = numeric(),
    GeneRatio_num = numeric(),
    neglog10_padj = numeric(),
    n_input_symbols = integer(),
    n_mapped_entrez = integer()
  )
}

go_enrich_direction <- function(
    genes,
    direction,
    ont = "BP",
    pvalue_cutoff = 0.05,
    qvalue_cutoff = 0.20,
    min_genes = 5
) {
  genes <- unique(as.character(genes))
  genes <- genes[!is.na(genes) & nzchar(genes)]
  
  if (length(genes) < min_genes) {
    return(empty_go_table())
  }
  
  orgdb <- getFromNamespace("org.Hs.eg.db", "org.Hs.eg.db")
  
  mapped <- suppressWarnings(
    clusterProfiler::bitr(
      genes,
      fromType = "SYMBOL",
      toType = "ENTREZID",
      OrgDb = orgdb
    )
  )
  
  mapped <- mapped[!is.na(mapped$ENTREZID), , drop = FALSE]
  entrez <- unique(as.character(mapped$ENTREZID))
  
  if (length(entrez) < min_genes) {
    return(empty_go_table())
  }
  
  ego <- suppressWarnings(
    clusterProfiler::enrichGO(
      gene = entrez,
      OrgDb = orgdb,
      ont = ont,
      pAdjustMethod = "BH",
      pvalueCutoff = pvalue_cutoff,
      qvalueCutoff = qvalue_cutoff,
      readable = TRUE
    )
  )
  
  if (is.null(ego)) {
    return(empty_go_table())
  }
  
  out <- as.data.frame(ego)
  
  if (nrow(out) == 0) {
    return(empty_go_table())
  }
  
  out %>%
    tibble::as_tibble() %>%
    dplyr::mutate(
      Direction = direction,
      Count = as.numeric(Count),
      pvalue = as.numeric(pvalue),
      p.adjust = as.numeric(p.adjust),
      qvalue = as.numeric(qvalue),
      GeneRatio = as.character(GeneRatio),
      GeneRatio_num = parse_gene_ratio(GeneRatio),
      neglog10_padj = -log10(p.adjust + 1e-300),
      n_input_symbols = length(genes),
      n_mapped_entrez = length(entrez)
    ) %>%
    dplyr::select(
      Direction,
      ID,
      Description,
      GeneRatio,
      BgRatio,
      pvalue,
      p.adjust,
      qvalue,
      geneID,
      Count,
      GeneRatio_num,
      neglog10_padj,
      n_input_symbols,
      n_mapped_entrez,
      dplyr::everything()
    )
}

run_go_from_de <- function(
    de_df,
    padj_cutoff = 0.05,
    logfc_cutoff = 0,
    ont = "BP",
    pvalue_cutoff = 0.05,
    qvalue_cutoff = 0.20,
    min_genes = 5,
    defining_gene = NULL
) {
  fc_col <- get_logfc_col(de_df)
  
  if (is.null(fc_col)) {
    stop("No logFC column found in the DE result.")
  }
  
  if (!requireNamespace("clusterProfiler", quietly = TRUE) ||
      !requireNamespace("org.Hs.eg.db", quietly = TRUE)) {
    stop(
      "GO enrichment requires Bioconductor packages clusterProfiler and org.Hs.eg.db. ",
      "Install them with: BiocManager::install(c('clusterProfiler', 'org.Hs.eg.db'))"
    )
  }
  
  logfc_cutoff <- abs(as.numeric(logfc_cutoff %||% 0))
  padj_cutoff <- as.numeric(padj_cutoff %||% 0.05)
  
  df <- de_df %>%
    dplyr::mutate(
      fc_for_go = .data[[fc_col]],
      padj_for_go = if ("p_val_adj" %in% colnames(.)) p_val_adj else p_val
    ) %>%
    dplyr::filter(!is.na(gene), !is.na(fc_for_go), !is.na(padj_for_go))
  
  if (!is.null(defining_gene) && length(defining_gene) > 0 && !is.na(defining_gene)) {
    df <- df %>% dplyr::filter(gene != defining_gene)
  }
  
  up_genes <- df %>%
    dplyr::filter(padj_for_go < padj_cutoff, fc_for_go > logfc_cutoff) %>%
    dplyr::arrange(padj_for_go) %>%
    dplyr::pull(gene) %>%
    unique()
  
  down_genes <- df %>%
    dplyr::filter(padj_for_go < padj_cutoff, fc_for_go < -logfc_cutoff) %>%
    dplyr::arrange(padj_for_go) %>%
    dplyr::pull(gene) %>%
    unique()
  
  go_down <- go_enrich_direction(
    genes = down_genes,
    direction = "Higher in Gene-",
    ont = ont,
    pvalue_cutoff = pvalue_cutoff,
    qvalue_cutoff = qvalue_cutoff,
    min_genes = min_genes
  )
  
  go_up <- go_enrich_direction(
    genes = up_genes,
    direction = "Higher in Gene+",
    ont = ont,
    pvalue_cutoff = pvalue_cutoff,
    qvalue_cutoff = qvalue_cutoff,
    min_genes = min_genes
  )
  
  dplyr::bind_rows(go_down, go_up) %>%
    dplyr::mutate(
      Direction = factor(Direction, levels = c("Higher in Gene-", "Higher in Gene+"))
    ) %>%
    dplyr::arrange(p.adjust, pvalue)
}

make_go_dotplot <- function(
    go_df,
    top_n = 10,
    base_size = 11,
    title = NULL,
    term_text_size = NULL,
    wrap_width = 42,
    panel_spacing_y = 0.35,
    tile_height = 0.58,
    segment_width = 2.7,
    point_range = c(3.2, 8.5)
) {
  validate(need(nrow(go_df) > 0, "No GO term selected for plotting."))
  
  top_n <- max(1, as.integer(top_n %||% 10))
  
  plot_df <- go_df %>%
    dplyr::mutate(
      Direction = as.character(Direction),
      Description = as.character(Description),
      Term_label = wrap_label(Description, width = wrap_width),
      Count = as.numeric(Count),
      p.adjust = as.numeric(p.adjust),
      GeneRatio_num = if ("GeneRatio_num" %in% colnames(.)) {
        as.numeric(GeneRatio_num)
      } else {
        parse_gene_ratio(GeneRatio)
      }
    ) %>%
    dplyr::filter(!is.na(GeneRatio_num), !is.na(p.adjust), !is.na(Count)) %>%
    dplyr::arrange(Direction, p.adjust, dplyr::desc(GeneRatio_num))
  
  validate(need(nrow(plot_df) > 0, "No plottable GO term after filtering."))
  
  plot_df <- plot_df %>%
    dplyr::mutate(
      Term_unique = paste(Direction, ID, Term_label, sep = "___")
    )
  
  term_levels <- rev(unique(plot_df$Term_unique))
  plot_df$Term_unique <- factor(plot_df$Term_unique, levels = term_levels)
  
  term_labels <- stats::setNames(
    plot_df$Term_label[match(term_levels, plot_df$Term_unique)],
    term_levels
  )
  
  x_max <- max(plot_df$GeneRatio_num, na.rm = TRUE)
  if (!is.finite(x_max) || x_max <= 0) {
    x_max <- 0.1
  }
  
  tile_x <- -max(x_max * 0.055, 0.006)
  tile_w <- max(x_max * 0.018, 0.003)
  
  term_cols <- stats::setNames(safe_palette(length(term_levels)), term_levels)
  
  if (is.null(title) || !nzchar(as.character(title))) {
    title <- NULL
  }
  
  ggplot(plot_df, aes(x = GeneRatio_num, y = Term_unique)) +
    geom_tile(
      aes(x = tile_x, fill = Term_unique),
      width = tile_w,
      height = tile_height,
      show.legend = FALSE
    ) +
    geom_segment(
      aes(
        x = 0,
        xend = GeneRatio_num,
        y = Term_unique,
        yend = Term_unique,
        color = p.adjust
      ),
      linewidth = segment_width,
      lineend = "round"
    ) +
    geom_point(
      aes(size = Count, color = p.adjust),
      alpha = 0.98
    ) +
    facet_grid(Direction ~ ., scales = "free_y", space = "free_y") +
    scale_y_discrete(labels = term_labels) +
    scale_x_continuous(
      limits = c(tile_x - tile_w, x_max * 1.08),
      breaks = pretty(c(0, x_max), n = 4),
      labels = function(x) ifelse(x < 0, "", sprintf("%.2f", x)),
      expand = c(0, 0)
    ) +
    scale_fill_manual(values = term_cols, guide = "none") +
    scale_color_gradientn(
      colours = c("#D9817D", "#B69AAA", "#5E7FA8"),
      name = "p.adjust",
      oob = scales::squish
    ) +
    scale_size_continuous(
      name = "Gene count",
      range = point_range
    ) +
    labs(
      title = title,
      x = "GeneRatio",
      y = NULL
    ) +
    theme_minimal(base_size = base_size) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold", size = base_size + 1),
      axis.title.x = element_text(size = base_size + 2, color = "black"),
      axis.text.x = element_text(size = base_size, color = "black", angle = 45, hjust = 1),
      axis.text.y = element_text(size = term_text_size %||% (base_size + 1), color = "#444444"),
      strip.text.y = element_blank(),
      panel.grid.major.y = element_blank(),
      panel.grid.minor = element_blank(),
      panel.grid.major.x = element_line(color = "#D9D9D9", linewidth = 0.8),
      axis.line.x = element_blank(),
      axis.ticks = element_blank(),
      legend.title = element_text(size = base_size, color = "black"),
      legend.text = element_text(size = base_size - 1, color = "black"),
      legend.position = "right",
      panel.spacing.y = unit(panel_spacing_y, "cm"),
      plot.margin = margin(15, 20, 15, 20)
    )
}

make_manual_feature_plot <- function(
    obj,
    reduction,
    gene,
    pt_size = 0.45,
    base_size = 11,
    coord_ratio = 1,
    title = NULL,
    min_expr = 0,
    max_quantile = 0.99
) {
  validate(
    need(reduction %in% Reductions(obj), paste0("Reduction not found: ", reduction)),
    need(gene %in% rownames(obj), paste0("Gene not found: ", gene))
  )
  
  emb <- Embeddings(obj, reduction)
  
  validate(
    need(ncol(emb) >= 2, paste0("Reduction ", reduction, " has fewer than 2 dimensions."))
  )
  
  emb <- emb[, 1:2, drop = FALSE]
  
  expr_df <- FetchData(
    obj,
    vars = gene,
    cells = rownames(emb)
  )
  
  df <- data.frame(
    cell = rownames(emb),
    umap_1 = emb[, 1],
    umap_2 = emb[, 2],
    expr = expr_df[rownames(emb), gene],
    stringsAsFactors = FALSE
  )
  
  df$expr[is.na(df$expr)] <- 0
  df$positive <- df$expr > min_expr
  
  n_pos <- sum(df$positive, na.rm = TRUE)
  
  if (n_pos > 0) {
    max_cut <- suppressWarnings(
      quantile(df$expr[df$positive], probs = max_quantile, na.rm = TRUE)
    )
    
    if (!is.finite(max_cut) || max_cut <= min_expr) {
      max_cut <- max(df$expr, na.rm = TRUE)
    }
    
    if (!is.finite(max_cut) || max_cut <= min_expr) {
      max_cut <- min_expr + 1
    }
    
    df$expr_plot <- pmin(df$expr, max_cut)
  } else {
    max_cut <- min_expr + 1
    df$expr_plot <- df$expr
  }
  
  df_bg <- df[!df$positive, , drop = FALSE]
  df_pos <- df[df$positive, , drop = FALSE]
  df_pos <- df_pos[order(df_pos$expr_plot), , drop = FALSE]
  
  if (is.null(title)) {
    title <- paste0(gene, " expression")
  }
  
  ggplot() +
    geom_point(
      data = df_bg,
      aes(x = umap_1, y = umap_2),
      color = "#eeeeee",
      size = pt_size,
      alpha = 0.75
    ) +
    geom_point(
      data = df_pos,
      aes(x = umap_1, y = umap_2, color = expr_plot),
      size = pt_size,
      alpha = 0.95
    ) +
    scale_color_gradientn(
      colors = c("#FAD7C7", "#E76F51", "#B2182B"),
      limits = c(min_expr, max_cut),
      oob = scales::squish,
      name = gene
    ) +
    labs(
      title = title,
      subtitle = paste0(n_pos, " positive cells"),
      x = NULL,
      y = NULL
    ) +
    theme_umap(base_size) +
    theme(
      legend.position = "right",
      plot.subtitle = element_text(hjust = 0.5, color = "grey35")
    ) +
    coord_fixed(ratio = coord_ratio)
}


