# ============================================================
# Server
# ============================================================

server <- function(input, output, session) {
  
  observeEvent(input$go_viewer, {
    updateNavbarPage(session, "mainnav", selected = "Single-cell viewer")
  })
  
  observeEvent(input$go_chip, {
    updateNavbarPage(session, "mainnav", selected = "T47-D ChIP viewer")
  })
  
  observe({
    updateSelectizeInput(session, "global_gene", choices = genes_all, selected = genes_all[1], server = TRUE)
    updateSelectizeInput(session, "minor_gene", choices = genes_all, selected = genes_all[1], server = TRUE)
    updateSelectizeInput(session, "de_gene", choices = genes_all, selected = genes_all[1], server = TRUE)
  })
  
  # ============================================================
  # Single-cell object helpers
  # ============================================================
  
  subtype_cells <- function(subtype) {
    colnames(seurat_obj)[as.character(seurat_obj$subtype) == as.character(subtype)]
  }
  
  major_choices_for_subtype <- function(subtype) {
    cells <- subtype_cells(subtype)
    out <- sort(unique(as.character(seurat_obj$celltype_major[cells])))
    out[!is.na(out)]
  }
  
  output$minor_major_ui <- renderUI({
    req(input$minor_subtype)
    choices <- major_choices_for_subtype(input$minor_subtype)
    selectInput("minor_major", "Major cell type", choices = choices, selected = choices[1])
  })
  
  output$de_major_ui <- renderUI({
    req(input$de_subtype)
    choices <- major_choices_for_subtype(input$de_subtype)
    selectInput("de_major", "Major cell type", choices = choices, selected = choices[1])
  })
  
  # ============================================================
  # Global object and plots
  # ============================================================
  
  global_obj <- reactive({
    req(input$global_subtype, input$global_groupby)
    
    cells <- subtype_cells(input$global_subtype)
    
    validate(
      need(length(cells) > 0, "No cells available for the selected subtype."),
      need(input$global_groupby %in% colnames(seurat_obj@meta.data), "Selected annotation not found.")
    )
    
    obj <- subset(seurat_obj, cells = cells)
    Idents(obj) <- input$global_groupby
    obj
  })
  
  global_palette <- reactive({
    obj <- global_obj()
    make_palette(obj@meta.data[[input$global_groupby]])
  })
  
  global_umap_plot <- reactive({
    obj <- global_obj()
    pal <- global_palette()
    
    DimPlot(
      obj,
      reduction = "umap",
      group.by = input$global_groupby,
      cols = pal,
      pt.size = input$global_pt_size,
      label = FALSE
    ) +
      labs(
        title = paste0(input$global_subtype, " global UMAP"),
        color = input$global_groupby
      ) +
      theme_umap(input$global_base_size) +
      theme(
        legend.position = "right",
        legend.text = element_text(size = input$global_legend_text),
        legend.title = element_text(size = input$global_legend_title)
      ) +
      coord_fixed(ratio = input$global_coord_ratio)
  })
  
  global_data_gene <- reactive({
    req(input$global_gene)
    obj <- global_obj()
    
    validate(
      need(input$global_gene %in% rownames(obj), paste0("Gene not found: ", input$global_gene))
    )
    
    FetchData(obj, vars = c(input$global_gene, input$global_groupby)) %>%
      rownames_to_column("cell") %>%
      dplyr::rename(group = dplyr::all_of(input$global_groupby)) %>%
      mutate(group = factor(as.character(group), levels = names(global_palette())))
  })
  
  global_jitter_plot <- reactive({
    df <- global_data_gene()
    pal <- global_palette()
    
    ggplot(df, aes(x = group, y = .data[[input$global_gene]], color = group)) +
      geom_jitter(width = 0.18, size = input$global_jitter_pt_size, alpha = 0.55) +
      stat_summary(
        fun = median,
        geom = "crossbar",
        width = 0.42,
        fatten = 0,
        color = "black",
        linewidth = 0.28
      ) +
      scale_color_manual(values = pal, drop = FALSE) +
      labs(title = input$global_gene, x = NULL, y = "Expression") +
      theme_paper(input$global_base_size) +
      theme(
        legend.position = "none",
        axis.line = element_blank(),
        axis.ticks = element_blank(),
        axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1)
      )
  })
  
  global_feature_plot <- reactive({
    req(input$global_gene)
    obj <- global_obj()
    
    make_manual_feature_plot(
      obj = obj,
      reduction = "umap",
      gene = input$global_gene,
      pt_size = input$global_feature_pt_size,
      base_size = input$global_base_size,
      coord_ratio = input$global_coord_ratio,
      title = paste0(input$global_gene, " expression"),
      min_expr = 0,
      max_quantile = 0.99
    )
  })
  
  output$global_umap <- renderPlot(global_umap_plot())
  output$global_jitter <- renderPlot(global_jitter_plot())
  output$global_feature <- renderPlot(global_feature_plot())
  
  output$global_dl_umap <- downloadHandler(
    filename = function() paste0(input$global_filebase, "_UMAP_", input$global_subtype, ".pdf"),
    content = function(file) save_pdf(global_umap_plot(), file, input$global_pdf_w, input$global_pdf_h)
  )
  
  output$global_dl_jitter <- downloadHandler(
    filename = function() paste0(input$global_filebase, "_Jitter_", input$global_subtype, "_", input$global_gene, ".pdf"),
    content = function(file) save_pdf(global_jitter_plot(), file, input$global_pdf_w, input$global_pdf_h)
  )
  
  output$global_dl_feature <- downloadHandler(
    filename = function() paste0(input$global_filebase, "_Feature_", input$global_subtype, "_", input$global_gene, ".pdf"),
    content = function(file) save_pdf(global_feature_plot(), file, input$global_pdf_w, input$global_pdf_h)
  )
  
  # ============================================================
  # Minor object and plots
  # ============================================================
  
  minor_reduction <- reactive({
    req(input$minor_subtype, input$minor_major)
    make_local_reduction_name(input$minor_subtype, input$minor_major)
  })
  
  minor_obj <- reactive({
    req(input$minor_subtype, input$minor_major, input$minor_groupby)
    
    cells <- colnames(seurat_obj)[
      as.character(seurat_obj$subtype) == as.character(input$minor_subtype) &
        as.character(seurat_obj$celltype_major) == as.character(input$minor_major)
    ]
    
    red <- minor_reduction()
    
    validate(
      need(length(cells) > 0, "No cells available for the selected population."),
      need(red %in% Reductions(seurat_obj), paste0("No local UMAP available for: ", input$minor_subtype, " / ", input$minor_major)),
      need(input$minor_groupby %in% colnames(seurat_obj@meta.data), "Selected annotation not found.")
    )
    
    obj <- subset(seurat_obj, cells = cells)
    Idents(obj) <- input$minor_groupby
    obj
  })
  
  output$minor_title <- renderText({
    req(input$minor_subtype, input$minor_major)
    paste0(input$minor_subtype, " ", input$minor_major)
  })
  
  minor_palette <- reactive({
    obj <- minor_obj()
    make_palette(obj@meta.data[[input$minor_groupby]])
  })
  
  minor_umap_plot <- reactive({
    obj <- minor_obj()
    red <- minor_reduction()
    pal <- minor_palette()
    
    validate(need(red %in% Reductions(obj), paste0("Reduction not found: ", red)))
    
    DimPlot(
      obj,
      reduction = red,
      group.by = input$minor_groupby,
      cols = pal,
      pt.size = input$minor_pt_size,
      label = FALSE
    ) +
      labs(
        title = paste0(input$minor_subtype, " ", input$minor_major),
        color = input$minor_groupby
      ) +
      theme_umap(input$minor_base_size) +
      theme(
        legend.position = "right",
        legend.text = element_text(size = input$minor_legend_text),
        legend.title = element_text(size = input$minor_legend_title)
      ) +
      coord_fixed(ratio = input$minor_coord_ratio)
  })
  
  minor_data_gene <- reactive({
    req(input$minor_gene)
    obj <- minor_obj()
    
    validate(need(input$minor_gene %in% rownames(obj), paste0("Gene not found: ", input$minor_gene)))
    
    FetchData(obj, vars = c(input$minor_gene, input$minor_groupby)) %>%
      rownames_to_column("cell") %>%
      dplyr::rename(group = dplyr::all_of(input$minor_groupby)) %>%
      mutate(group = factor(as.character(group), levels = names(minor_palette())))
  })
  
  minor_jitter_plot <- reactive({
    df <- minor_data_gene()
    pal <- minor_palette()
    
    ggplot(df, aes(x = group, y = .data[[input$minor_gene]], color = group)) +
      geom_jitter(width = 0.18, size = input$minor_jitter_pt_size, alpha = 0.55) +
      stat_summary(
        fun = median,
        geom = "crossbar",
        width = 0.42,
        fatten = 0,
        color = "black",
        linewidth = 0.28
      ) +
      scale_color_manual(values = pal, drop = FALSE) +
      labs(title = input$minor_gene, x = NULL, y = "Expression") +
      theme_paper(input$minor_base_size) +
      theme(
        legend.position = "none",
        axis.line = element_blank(),
        axis.ticks = element_blank(),
        axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1)
      )
  })
  
  minor_feature_plot <- reactive({
    req(input$minor_gene)
    obj <- minor_obj()
    red <- minor_reduction()
    
    make_manual_feature_plot(
      obj = obj,
      reduction = red,
      gene = input$minor_gene,
      pt_size = input$minor_feature_pt_size,
      base_size = input$minor_base_size,
      coord_ratio = input$minor_coord_ratio,
      title = paste0(input$minor_gene, " expression"),
      min_expr = 0,
      max_quantile = 0.99
    )
  })
  
  output$minor_umap <- renderPlot(minor_umap_plot())
  output$minor_jitter <- renderPlot(minor_jitter_plot())
  output$minor_feature <- renderPlot(minor_feature_plot())
  
  output$minor_dl_umap <- downloadHandler(
    filename = function() paste0(input$minor_filebase, "_UMAP_", input$minor_subtype, "_", input$minor_major, ".pdf"),
    content = function(file) save_pdf(minor_umap_plot(), file, input$minor_pdf_w, input$minor_pdf_h)
  )
  
  output$minor_dl_jitter <- downloadHandler(
    filename = function() paste0(input$minor_filebase, "_Jitter_", input$minor_subtype, "_", input$minor_major, "_", input$minor_gene, ".pdf"),
    content = function(file) save_pdf(minor_jitter_plot(), file, input$minor_pdf_w, input$minor_pdf_h)
  )
  
  output$minor_dl_feature <- downloadHandler(
    filename = function() paste0(input$minor_filebase, "_Feature_", input$minor_subtype, "_", input$minor_major, "_", input$minor_gene, ".pdf"),
    content = function(file) save_pdf(minor_feature_plot(), file, input$minor_pdf_w, input$minor_pdf_h)
  )
  
  # ============================================================
  # DE
  # ============================================================
  
  de_base_obj <- reactive({
    req(input$de_subtype)
    cells <- subtype_cells(input$de_subtype)
    validate(need(length(cells) > 0, "No cells available for the selected subtype."))
    subset(seurat_obj, cells = cells)
  })
  
  de_major_obj <- reactive({
    req(input$de_subtype, input$de_major)
    obj <- de_base_obj()
    cells <- colnames(obj)[as.character(obj$celltype_major) == as.character(input$de_major)]
    validate(need(length(cells) > 0, "No cells available for the selected major cell type."))
    subset(obj, cells = cells)
  })
  
  output$de_minor_level_ui <- renderUI({
    req(input$de_scope, input$de_major, input$de_minor_groupby)
    
    if (!identical(input$de_scope, "minor_annotation")) {
      return(NULL)
    }
    
    obj <- de_major_obj()
    validate(need(input$de_minor_groupby %in% colnames(obj@meta.data), "Minor annotation not found."))
    
    levels_use <- sort(unique(as.character(obj@meta.data[[input$de_minor_groupby]])))
    levels_use <- levels_use[!is.na(levels_use)]
    
    selectInput("de_minor_level", "Minor population", choices = levels_use, selected = levels_use[1])
  })
  
  de_obj <- reactive({
    if (identical(input$de_scope, "all")) {
      obj <- de_base_obj()
    } else if (identical(input$de_scope, "major")) {
      obj <- de_major_obj()
    } else {
      req(input$de_minor_groupby, input$de_minor_level)
      obj <- de_major_obj()
      
      cells <- colnames(obj)[
        as.character(obj@meta.data[[input$de_minor_groupby]]) == as.character(input$de_minor_level)
      ]
      
      validate(need(length(cells) > 0, "No cells available for the selected minor population."))
      obj <- subset(obj, cells = cells)
    }
    
    obj
  })
  
  de_group_counts <- reactive({
    req(input$de_gene)
    obj <- de_obj()
    
    validate(need(input$de_gene %in% rownames(obj), paste0("Gene not found: ", input$de_gene)))
    
    x <- FetchData(obj, vars = input$de_gene)[, 1]
    
    data.frame(
      group = c("Gene-", "Gene+"),
      definition = c(
        paste0(input$de_gene, " <= ", input$de_thresh),
        paste0(input$de_gene, " > ", input$de_thresh)
      ),
      cells = c(sum(x <= input$de_thresh), sum(x > input$de_thresh))
    )
  })
  
  output$de_group_table <- renderTable(de_group_counts())
  
  de_result <- eventReactive(input$de_run, {
    req(input$de_gene)
    obj <- de_obj()
    
    validate(need(input$de_gene %in% rownames(obj), paste0("Gene not found: ", input$de_gene)))
    
    x <- FetchData(obj, vars = input$de_gene)[, 1]
    
    obj$gene_group <- factor(
      ifelse(x > input$de_thresh, "Gene+", "Gene-"),
      levels = c("Gene-", "Gene+")
    )
    
    Idents(obj) <- "gene_group"
    n_tab <- table(Idents(obj))
    
    validate(
      need("Gene-" %in% names(n_tab), "Gene- group is missing."),
      need("Gene+" %in% names(n_tab), "Gene+ group is missing."),
      need(n_tab[["Gene-"]] >= input$de_min_cells, paste0("Too few Gene- cells: ", n_tab[["Gene-"]])),
      need(n_tab[["Gene+"]] >= input$de_min_cells, paste0("Too few Gene+ cells: ", n_tab[["Gene+"]]))
    )
    
    withProgress(message = "Running differential expression", value = 0, {
      incProgress(0.2)
      
      res <- FindMarkers(
        obj,
        ident.1 = "Gene+",
        ident.2 = "Gene-",
        test.use = input$de_test,
        logfc.threshold = 0,
        min.pct = 0.1,
        verbose = FALSE
      )
      
      incProgress(0.8)
      
      out <- res %>%
        rownames_to_column("gene") %>%
        arrange(p_val_adj, p_val)
      
      attr(out, "n_geneplus") <- as.integer(n_tab[["Gene+"]])
      attr(out, "n_geneminus") <- as.integer(n_tab[["Gene-"]])
      attr(out, "gene") <- input$de_gene
      attr(out, "threshold") <- input$de_thresh
      attr(out, "test") <- input$de_test
      attr(out, "subtype") <- input$de_subtype
      attr(out, "scope") <- input$de_scope
      attr(out, "major") <- input$de_major %||% NA
      attr(out, "minor_groupby") <- input$de_minor_groupby %||% NA
      attr(out, "minor_level") <- input$de_minor_level %||% NA
      
      out
    })
  }, ignoreInit = TRUE)
  
  output$de_summary <- renderPrint({
    res <- de_result()
    
    cat("Gene:", attr(res, "gene"), "\n")
    cat("Subtype:", attr(res, "subtype"), "\n")
    
    if (attr(res, "scope") == "all") {
      cat("Population: all cells\n")
    }
    
    if (attr(res, "scope") == "major") {
      cat("Population:", attr(res, "major"), "\n")
    }
    
    if (attr(res, "scope") == "minor_annotation") {
      cat("Major:", attr(res, "major"), "\n")
      cat("Minor:", attr(res, "minor_level"), "\n")
      cat("Annotation:", attr(res, "minor_groupby"), "\n")
    }
    
    cat("Threshold:", attr(res, "threshold"), "\n")
    cat("Test:", attr(res, "test"), "\n")
    cat("Gene+ cells:", attr(res, "n_geneplus"), "\n")
    cat("Gene- cells:", attr(res, "n_geneminus"), "\n")
    cat("Genes tested:", nrow(res), "\n")
  })
  
  de_volcano_plot <- reactive({
    res <- de_result()
    
    fc_col <- if ("avg_log2FC" %in% colnames(res)) {
      "avg_log2FC"
    } else if ("avg_logFC" %in% colnames(res)) {
      "avg_logFC"
    } else {
      NULL
    }
    
    validate(
      need(!is.null(fc_col), "No logFC column found.")
    )
    
    df <- res %>%
      dplyr::mutate(
        fc = .data[[fc_col]],
        neglog10_padj = -log10(p_val_adj + 1e-300),
        category = dplyr::case_when(
          p_val_adj < input$de_padj_cut & fc >= input$de_logfc_cut ~ "Higher in Gene+",
          p_val_adj < input$de_padj_cut & fc <= -input$de_logfc_cut ~ "Higher in Gene-",
          TRUE ~ "Not significant"
        )
      )
    
    top_labels <- df %>%
      dplyr::filter(category != "Not significant") %>%
      dplyr::arrange(p_val_adj) %>%
      dplyr::slice_head(n = input$de_label_n)
    
    p <- ggplot(df, aes(x = fc, y = neglog10_padj)) +
      geom_vline(
        xintercept = c(-input$de_logfc_cut, input$de_logfc_cut),
        linetype = "dashed",
        linewidth = 0.35,
        color = "grey60"
      ) +
      geom_hline(
        yintercept = -log10(input$de_padj_cut),
        linetype = "dashed",
        linewidth = 0.35,
        color = "grey60"
      ) +
      geom_point(
        aes(color = category),
        size = 1.1,
        alpha = 0.75
      ) +
      scale_color_manual(
        values = c(
          "Higher in Gene+" = "#B2182B",
          "Higher in Gene-" = "#2166AC",
          "Not significant" = "grey78"
        )
      ) +
      labs(
        title = paste0(input$de_gene, " Gene+ versus Gene-"),
        x = fc_col,
        y = "-log10 adjusted p-value",
        color = NULL
      ) +
      theme_paper(input$de_base_size) +
      theme(
        legend.position = "top",
        panel.grid.major = element_line(color = "grey90", linewidth = 0.25),
        panel.grid.minor = element_line(color = "grey95", linewidth = 0.15)
      )
    
    if (nrow(top_labels) > 0 && requireNamespace("ggrepel", quietly = TRUE)) {
      p <- p +
        ggrepel::geom_text_repel(
          data = top_labels,
          aes(label = gene),
          size = 3,
          max.overlaps = Inf,
          box.padding = 0.35,
          point.padding = 0.2,
          min.segment.length = 0,
          segment.color = "grey60",
          show.legend = FALSE
        )
    } else if (nrow(top_labels) > 0) {
      p <- p +
        geom_text(
          data = top_labels,
          aes(label = gene),
          size = 3,
          vjust = -0.4,
          show.legend = FALSE
        )
    }
    
    p
  })
  
  output$de_volcano <- renderPlot(de_volcano_plot())
  
  output$de_table <- renderDT({
    res <- de_result()
    
    DT::datatable(
      res,
      rownames = FALSE,
      filter = "top",
      options = list(pageLength = 20, scrollX = TRUE)
    )
  })
  
  output$de_dl_csv <- downloadHandler(
    filename = function() paste0(input$de_filebase, "_", input$de_subtype, "_", input$de_gene, ".csv"),
    content = function(file) readr::write_csv(de_result(), file)
  )
  
  output$de_dl_volcano <- downloadHandler(
    filename = function() paste0(input$de_filebase, "_Volcano_", input$de_subtype, "_", input$de_gene, ".pdf"),
    content = function(file) save_pdf(de_volcano_plot(), file, input$de_pdf_w, input$de_pdf_h)
  )
  
  # ============================================================
  # T47-D ChIP viewer
  # ============================================================
  
  chip_regionGR <- eventReactive(input$chip_go, {
    sym <- trimws(input$chip_gene)
    
    validate(need(nzchar(sym), "Please enter a gene symbol."))
    
    txs <- genes(
      EnsDb.Hsapiens.v86,
      filter = GeneNameFilter(sym)
    )
    
    if (length(txs) == 0 && grepl("^ENSG\\d+", sym, ignore.case = TRUE)) {
      txs <- genes(
        EnsDb.Hsapiens.v86,
        filter = GeneIdFilter(sym)
      )
    }
    
    validate(need(length(txs) > 0, paste0("Gene not found in EnsDb.Hsapiens.v86: ", sym)))
    
    gr <- range(txs) + input$chip_flank
    seqlevelsStyle(gr) <- "UCSC"
    genome(gr) <- "hg38"
    seqlengths(gr) <- NA
    gr
  })
  
  chip_peaksRawInRegion <- reactive({
    gr0 <- chip_regionGR()
    req(gr0)
    
    validate(need(file.exists(CFILE_T47D), paste0("Missing file: ", CFILE_T47D)))
    
    df <- readr::read_tsv(
      CFILE_T47D,
      col_names = c("chrom", "start", "end", "SRX", "gene", "score"),
      show_col_types = FALSE
    ) %>%
      mutate(
        start = as.numeric(start),
        end = as.numeric(end),
        score = suppressWarnings(as.numeric(score))
      )
    
    gr_df <- GRanges(df$chrom, IRanges(df$start, df$end))
    sel <- queryHits(findOverlaps(gr_df, gr0))
    
    df <- df[sel, , drop = FALSE]
    
    validate(need(nrow(df) > 0, "No peaks in region."))
    
    df %>%
      mutate(
        pos = (start + end) / 2,
        url = paste0(SRX_URL_BASE, SRX),
        tooltip = paste0(
          "Type: TF, all antibodies",
          "<br>Factor: ", gene,
          "<br>SRX: <a href='", SRX_URL_BASE, SRX, "' target='_blank'>", SRX, "</a>",
          "<br>", chrom, ":", start, "-", end,
          "<br>Score: ", score
        )
      )
  })
  
  observeEvent(chip_peaksRawInRegion(), {
    df <- chip_peaksRawInRegion()
    
    updateSelectizeInput(
      session,
      "chip_filter_factor",
      choices = sort(unique(df$gene)),
      selected = character(0),
      server = TRUE
    )
  })
  
  chip_peaksInRegion <- reactive({
    df <- chip_peaksRawInRegion()
    
    if (!is.null(input$chip_filter_factor) && length(input$chip_filter_factor) > 0) {
      df <- dplyr::filter(df, gene %in% input$chip_filter_factor)
    }
    
    dplyr::filter(df, score >= input$chip_minscore)
  })
  
  chip_legend_colors <- reactive({
    df <- chip_peaksInRegion()
    genes_present <- sort(unique(df$gene))
    setNames(safe_palette(length(genes_present)), genes_present)
  })
  
  output$chip_plot <- renderPlotly({
    gr <- chip_regionGR()
    req(gr)
    
    df <- chip_peaksInRegion()
    validate(need(nrow(df) > 0, "No data after filtering."))
    
    tf_colors <- chip_legend_colors()
    shapes <- NULL
    
    if (isTRUE(input$chip_showccre) && !is.null(ccres)) {
      cc0 <- subsetByOverlaps(ccres, gr)
      
      if (length(cc0) > 0) {
        ccdf <- tibble::as_tibble(cc0) %>%
          transmute(
            x0 = start,
            x1 = end,
            cls = factor(creClass, levels = ccre_classes)
          )
        
        shapes <- lapply(seq_len(nrow(ccdf)), function(i) {
          list(
            type = "rect",
            xref = "x",
            yref = "paper",
            x0 = ccdf$x0[i],
            x1 = ccdf$x1[i],
            y0 = 0,
            y1 = 1,
            fillcolor = ccre_cols[as.character(ccdf$cls[i])],
            opacity = 0.3,
            line = list(width = 0),
            layer = "below"
          )
        })
      }
    }
    
    p <- plot_ly(
      df,
      x = ~pos,
      y = ~score,
      text = ~tooltip,
      hoverinfo = "text",
      type = "scatter",
      mode = "markers",
      marker = list(size = input$chip_ptsize, opacity = 1),
      color = ~gene,
      colors = tf_colors,
      showlegend = FALSE,
      customdata = ~url
    ) %>%
      layout(
        title = list(text = paste0("<b>T47-D cCREs and TFs within the ", input$chip_gene, " region</b>")),
        shapes = shapes,
        margin = list(l = 96, r = 28, t = 64, b = 72),
        xaxis = list(
          title = paste0(as.character(seqnames(gr)), ":", start(gr), "-", end(gr)),
          automargin = TRUE
        ),
        yaxis = list(title = list(text = "<b>MACS2 binding score</b>"), automargin = TRUE)
      ) %>%
      config(displaylogo = FALSE, responsive = TRUE)
    
    htmlwidgets::onRender(p, "
      function(el, x) {
        el.on('plotly_click', function(e) {
          if (e && e.points && e.points.length > 0) {
            var url = e.points[0].customdata;
            if (url) window.open(url, '_blank');
          }
        });
      }
    ")
  })
  
  chip_plot_static <- reactive({
    gr <- chip_regionGR()
    req(gr)
    
    df <- chip_peaksInRegion()
    validate(need(nrow(df) > 0, "No data after filtering."))
    
    cols_tf <- chip_legend_colors()
    ccre_df <- NULL
    
    if (isTRUE(input$chip_showccre) && !is.null(ccres)) {
      cc0 <- subsetByOverlaps(ccres, gr)
      
      if (length(cc0) > 0) {
        ccre_df <- tibble::as_tibble(cc0) %>%
          transmute(
            xstart = start,
            xend = end,
            cls = creClass
          )
      }
    }
    
    base <- ggplot() +
      theme_minimal(base_size = 12) +
      theme(
        panel.grid.major = element_line(color = "grey90", linewidth = 0.25),
        panel.grid.minor = element_line(color = "grey95", linewidth = 0.15),
        plot.title = element_text(face = "bold", hjust = 0.5),
        legend.position = if (isTRUE(input$chip_showlegend)) "right" else "none"
      )
    
    if (!is.null(ccre_df) && nrow(ccre_df) > 0) {
      base <- base +
        geom_rect(
          data = ccre_df,
          aes(
            xmin = xstart,
            xmax = xend,
            ymin = -Inf,
            ymax = Inf,
            fill = cls
          ),
          inherit.aes = FALSE,
          alpha = 0.25,
          color = NA
        ) +
        scale_fill_manual(values = ccre_cols, guide = "none")
    }
    
    base +
      geom_point(
        data = df,
        aes(x = pos, y = score, color = gene),
        size = input$chip_ptsize * 0.4,
        alpha = 0.9
      ) +
      scale_color_manual(
        values = cols_tf,
        guide = if (isTRUE(input$chip_showlegend)) "legend" else "none"
      ) +
      labs(
        title = paste0("T47-D ChIP peaks in ", input$chip_gene, " region"),
        x = paste0(as.character(seqnames(gr)), ":", start(gr), "-", end(gr)),
        y = "MACS2 binding score"
      )
  })
  
  output$chip_dl_pdf <- downloadHandler(
    filename = function() paste0("T47D_ChIP_", input$chip_gene, ".pdf"),
    content = function(file) save_pdf(chip_plot_static(), file, input$chip_pdf_w, input$chip_pdf_h)
  )
  
  output$chip_ccreLegend <- renderUI({
    if (!isTRUE(input$chip_showccre) || is.null(ccres)) {
      return(NULL)
    }
    
    gr <- chip_regionGR()
    req(gr)
    
    cc0 <- subsetByOverlaps(ccres, gr)
    
    if (length(cc0) == 0) {
      return(NULL)
    }
    
    present <- unique(as.character(cc0$creClass))
    present <- intersect(ccre_classes, present)
    
    if (length(present) == 0) {
      return(NULL)
    }
    
    items <- lapply(present, function(cls) {
      tags$span(
        class = "chip-legend-item",
        tags$span(class = "chip-swatch", style = paste0("background:", ccre_cols[[cls]], ";")),
        tags$span(cls)
      )
    })
    
    tags$div(style = "margin-top:8px;", tags$strong("ENCODE cCRE: "), items)
  })
  
  output$chip_tfLegend <- renderUI({
    if (!isTRUE(input$chip_showlegend)) {
      return(NULL)
    }
    
    cols <- chip_legend_colors()
    
    if (length(cols) == 0) {
      return(NULL)
    }
    
    items <- lapply(names(cols), function(name) {
      tags$span(
        class = "chip-legend-item",
        tags$span(class = "chip-swatch", style = paste0("background:", cols[[name]], ";")),
        tags$span(name)
      )
    })
    
    tags$div(style = "margin-top:8px;", tags$strong("Factor legend: "), items)
  })
  
  output$chip_regionInfo <- renderTable({
    gr <- chip_regionGR()
    req(gr)
    
    data.frame(
      Chromosome = as.character(seqnames(gr)),
      Start = start(gr),
      End = end(gr),
      Width = width(gr)
    )
  })
}

shinyApp(ui, server)
